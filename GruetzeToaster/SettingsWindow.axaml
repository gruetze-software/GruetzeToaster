<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:GruetzeToaster.Controls"
        x:Class="GruetzeToaster.SettingsWindow" Classes="dialog"
        Title="GruetzeToaster · Settings" Icon="/Assets/app-icon.ico"
        Width="720" MinWidth="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,Auto,Auto" Margin="28">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
            <StackPanel Spacing="7" VerticalAlignment="Center">
                <TextBlock Text="Settings" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="Make the flying toasters your own." Classes="hint"/>
            </StackPanel>
            <Image Name="LogoImage" Grid.Column="1" Width="60" Height="60" Margin="18,0,4,0"
                   RenderOptions.BitmapInterpolationMode="None"/>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="16">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Classes="card">
                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Number of objects" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#163F3C" CornerRadius="5" Padding="10,4" MinWidth="48">
                                <TextBlock Name="CountLabel" Foreground="#93DDD1" FontWeight="SemiBold" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Slider Name="CountSlider" Minimum="1" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="Number of objects per screen"/>
                        <TextBlock Text="1 to 200 objects per screen." Classes="hint"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Speed" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#163F3C" CornerRadius="5" Padding="10,4" MinWidth="48">
                                <TextBlock Name="SpeedLabel" Foreground="#93DDD1" FontWeight="SemiBold" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Slider Name="SpeedSlider" Minimum="0.2" Maximum="5" AutomationProperties.Name="Speed"/>
                        <TextBlock Text="From a leisurely 0.2× to a speedy 5×." Classes="hint"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Classes="card">
                <StackPanel Spacing="5">
                    <TextBlock Text="Retro companions" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <Grid ColumnDefinitions="*,*">
                        <CheckBox Name="C64CheckBox" Content="Include C64-inspired computer"/>
                        <CheckBox Grid.Column="1" Name="AmigaCheckBox" Content="Include Amiga-inspired computer"/>
                    </Grid>
                    <TextBlock Text="Blinking red light on the C64; a sliding floppy disk on the Amiga."
                               Classes="hint"/>
                </StackPanel>
            </Border>
            <Border Classes="card">
                <StackPanel Spacing="5">
                    <CheckBox Name="FpsCheckBox" Content="Show frame rate on startup"/>
                    <TextBlock Text="Press F during the animation to toggle the frame rate display."
                               Classes="hint" Margin="28,0,0,0"/>
                </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                <TextBlock Name="VersionLabel" Classes="hint" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="icon" Content="About &amp; Support" Click="About_Click"
                        ui:ButtonIcons.Icon="{x:Static ui:ButtonIcons.Info}"/>
            </Grid>
            <TextBlock Name="StatusLabel" Foreground="#FFCC80" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,22,0,0">
            <Button Classes="icon" Content="Reset" Click="Reset_Click" HorizontalAlignment="Left"
                    ui:ButtonIcons.Icon="{x:Static ui:ButtonIcons.Reset}"/>
            <Button Grid.Column="1" Classes="icon" Content="Cancel" Click="Cancel_Click" IsCancel="True"
                    Margin="12,0,10,0" ui:ButtonIcons.Icon="{x:Static ui:ButtonIcons.Close}"/>
            <Button Grid.Column="2" Name="SaveButton" Classes="icon primary" Content="Save" Click="Save_Click"
                    IsDefault="True" ui:ButtonIcons.Icon="{x:Static ui:ButtonIcons.Save}"/>
        </Grid>
    </Grid>
</Window>
